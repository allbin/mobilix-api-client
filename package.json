  "devDependencies": {
    "@allbin/eslint-config": "0.0.11",
    "@types/luxon": "^2.0.5",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^2.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
